@model PizzaPlanetaBiblioteca.DTOs.PizzaAltaDto
@{
    ViewData["Title"] = "Nueva Pizza";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="card-title mb-0">Alta de Nueva Pizza</h3>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Volver al catálogo</a>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre de la Pizza</label>
                        <input asp-for="Nombre" class="form-control" required placeholder="Ej: Napolitana con Jamón" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Detalle de ingredientes y preparación"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Precio" class="form-label">Precio ($)</label>
                        <input asp-for="Precio" type="number" step="0.01" min="0.01" class="form-control" required placeholder="12500.00" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImagenUrl" class="form-label">URL de Imagen (Opcional)</label>
                        <input asp-for="ImagenUrl" type="url" class="form-control" placeholder="https://images.unsplash.com/..." />
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Guardar Pizza</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
