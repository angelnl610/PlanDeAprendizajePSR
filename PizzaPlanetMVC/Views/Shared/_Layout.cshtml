<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pizza Planeta</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600;700&family=Unbounded:wght@400;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Site Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-arcade">
            <div class="container">
                <a class="navbar-brand brand-arcade d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span>🍕</span> PIZZA PLANETA
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarArcadeContent" 
                        aria-controls="navbarArcadeContent" aria-expanded="false" aria-label="Navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="#navbarArcadeContent">
                    <ul class="navbar-nav gap-2">
                        <li class="nav-item">
                            <a class="nav-link nav-link-arcade @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                [ INICIO ]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-arcade @(ViewContext.RouteData.Values["action"]?.ToString() == "Pizzas" ? "active" : "")" asp-controller="Home" asp-action="Pizzas">
                                [ CATÁLOGO DE PIZZAS ]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-arcade text-warning" href="http://localhost:5272/swagger" target="_blank">
                                [ API REST ]
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="arcade-footer">
        <div class="container">
            <div class="row align-items-center gy-3">
                <div class="col-md-7 text-center text-md-start">
                    <div class="footer-brand mb-1">PIZZA PLANETA</div>
                    <div class="footer-copy">
                        &copy; 1982-2026 PIZZA PLANETA. ALL PROTOCOLS ENFORCED.
                    </div>
                </div>
                <div class="col-md-5 text-center text-md-end">
                    <span class="insert-coin-prompt">
                        INSERT COIN TO PLAY [ 0.25$ ]
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
